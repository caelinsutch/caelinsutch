{
	"name": "caelinsutch",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "biome check src/components src/styles/global.css src/content.config.ts",
		"lint:fix": "biome check --write src/components src/styles/global.css src/content.config.ts",
		"format": "biome format --write .",
		"deploy": "bun run build && wrangler deploy"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^12.6.12",
		"@astrojs/mdx": "^4.3.13",
		"@astrojs/react": "^4.4.2",
		"astro": "^5.17.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@tailwindcss/postcss": "^4.1.18",
		"postcss": "^8.5.6",
		"tailwindcss": "^4.0.0",
		"wrangler": "^4.50.0"
	}
}
