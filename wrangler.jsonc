{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "caelinsutch",
	"main": "./dist/_worker.js/index.js",
	"compatibility_date": "2026-08-09",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "caelinsutch.com",
			"custom_domain": true
		},
		{
			"pattern": "www.caelinsutch.com",
			"custom_domain": true
		}
	]
}
